<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#10131A" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="COLOR CLASH" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="30sp" android:layout_marginTop="24dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LAN CARD GAME" android:textColor="#FFD54A" android:textStyle="bold" android:textSize="14sp" android:layout_marginBottom="24dp"/>
    <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Starting local game server…" android:textColor="#D7DAE0" android:textSize="16sp" android:gravity="center" android:padding="10dp"/>
    <TextView android:id="@+id/linkText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="19sp" android:gravity="center" android:padding="14dp" android:textIsSelectable="true"/>
    <ImageView android:id="@+id/qrImage" android:layout_width="260dp" android:layout_height="260dp" android:layout_margin="12dp" android:background="#FFFFFF" android:padding="8dp"/>
    <Button android:id="@+id/openButton" android:layout_width="match_parent" android:layout_height="56dp" android:text="افتح اللعبة على هذا الهاتف" android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="10dp"/>
    <Button android:id="@+id/shareButton" android:layout_width="match_parent" android:layout_height="56dp" android:text="مشاركة رابط اللعبة" android:textSize="16sp" android:layout_marginTop="10dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="يجب أن تكون جميع الأجهزة متصلة بنفس شبكة Wi‑Fi. اترك التطبيق مفتوحًا أثناء اللعب." android:textColor="#AEB4C0" android:textSize="14sp" android:gravity="center" android:padding="18dp"/>
  </LinearLayout>
</ScrollView>
